//@version=6
// INDAI Bridge: sends the newest candle for up to 8 tickers to INDAI each time a bar closes,
// so INDAI's charts, setup alerts and trade analysis run on your TradingView data.
// Between closes it also sends the candle that is still forming, up to 3 times a minute, so prices in INDAI
// move about every 15 seconds instead of once a minute.
//
// Setup (about 3 minutes):
//   1. TradingView: turn on two-factor authentication (Profile > Settings > Security). Webhooks need it.
//   2. Pine Editor > paste this script > Save > Add to chart. Use a 1-minute chart of any ticker.
//   3. Pick your tickers in the indicator's settings (defaults: SPY, QQQ, IWM, TSLA, AMZN, MSFT).
//      Keep the BATS: prefix. BATS (Cboe) data is real-time on every TradingView account; NASDAQ:/AMEX:
//      symbols need paid exchange data, and TradingView blocks alerts on them without it.
//   4. Create an alert: Condition = "INDAI Bridge", then change "Crossing" to "Any alert() function call".
//      Notifications > Webhook URL = the INDAI link you were given. Leave the message box as it is.
//   One alert covers every ticker. Alerts on the Essential plan expire after 2 months; just re-create it.
//
// Extended hours: with "Send pre-market and after-hours candles" ticked (the default) the bridge also sends the
// candles outside 9:30-16:00 New York time, so INDAI has a current price before the open and after the close.
// For that the alert has to sit on a chart that keeps printing candles outside regular hours: turn on
// "Extended trading hours" for the chart (the session menu at the bottom right) before creating the alert.
// An alert keeps the script as it was when the alert was created. After pasting a newer version of this script,
// delete the old alert and create it again (step 4), or INDAI keeps receiving the old behaviour.
//
// Price updates while a candle is forming: TradingView stops an alert that fires more than 15 times in
// 3 minutes. With 3 updates a minute plus the close this alert fires 12 times in 3 minutes, so leave the
// setting at 3 or lower. The updates need a 1-minute chart, and they come when the chart's own ticker trades,
// so put the alert on a busy one (SPY or QQQ).
indicator("INDAI Bridge", shorttitle = "INDAI", overlay = true)

t1 = input.symbol("BATS:SPY", "Ticker 1")
t2 = input.symbol("BATS:QQQ", "Ticker 2")
t3 = input.symbol("BATS:IWM", "Ticker 3")
t4 = input.symbol("BATS:TSLA", "Ticker 4")
t5 = input.symbol("BATS:AMZN", "Ticker 5")
t6 = input.symbol("BATS:MSFT", "Ticker 6")
use7 = input.bool(false, "Also send ticker 7", inline = "7")
t7 = input.symbol("BATS:NVDA", "", inline = "7")
use8 = input.bool(false, "Also send ticker 8", inline = "8")
t8 = input.symbol("BATS:AAPL", "", inline = "8")
showStatus = input.bool(true, "Show status box")
useExt = input.bool(true, "Send pre-market and after-hours candles")
liveN = input.int(3, "Price updates a minute while a candle is forming (0 = only when it closes)", minval = 0, maxval = 3)

num(x) => str.tostring(x, "#.####")

barJson(simple string sym) =>
    // the same ticker, asked for with or without the extended session
    string asked = ticker.modify(sym, useExt ? session.extended : session.regular)
    [o, h, l, c, v, t] = request.security(asked, timeframe.period, [open, high, low, close, volume, time])
    na(c) ? "" : '{"s":"' + sym + '","t":' + str.tostring(t) + ',"o":' + num(o) + ',"h":' + num(h) + ',"l":' + num(l) + ',"c":' + num(c) + ',"v":' + str.tostring(nz(v), "#") + '}'

join(string acc, string item) =>
    item == "" ? acc : acc == "" ? item : acc + "," + item

// every request runs on every bar (simple, reliable); only the alert is conditional
j1 = barJson(t1)
j2 = barJson(t2)
j3 = barJson(t3)
j4 = barJson(t4)
j5 = barJson(t5)
j6 = barJson(t6)
j7 = barJson(t7)
j8 = barJson(t8)

var int sent = 0
// varip: these keep their value from tick to tick inside one candle
varip int part = 0      // which part of the forming candle has had its update (the candle is cut into liveN + 1 parts)
varip int updates = 0   // updates sent since the script was loaded
if barstate.isnew
    part := 0
if barstate.isrealtime
    string body = join(join(join(join(join(join(j1, ""), j2), j3), j4), j5), j6)
    if use7
        body := join(body, j7)
    if use8
        body := join(body, j8)
    if body != ""
        if barstate.isconfirmed
            // the finished candle: INDAI's charts, setup alerts and history are built from these
            alert('{"kind":"bars","tf":"' + timeframe.period + '","bars":[' + body + ']}', alert.freq_once_per_bar_close)
            sent += 1
        else if liveN > 0 and timeframe.period == "1"
            // the candle so far: the first tick in each later part of the minute sends one update, never more
            int slice = int(math.floor((timenow - time) / (60000.0 / (liveN + 1))))
            if slice > part and slice <= liveN
                part := slice
                updates += 1
                alert('{"kind":"live","tf":"1","bars":[' + body + ']}', alert.freq_all)

var table box = table.new(position.bottom_right, 1, 1)
if showStatus and barstate.islast
    string live = liveN > 0 and timeframe.period == "1" ? " · " + str.tostring(updates) + " updates between" : ""
    table.cell(box, 0, 0, "INDAI Bridge · " + timeframe.period + (timeframe.isminutes ? "m" : "") + " · sent " + str.tostring(sent) + live, text_color = color.white, bgcolor = color.new(#0c121d, 10), text_size = size.small)

plot(na, "INDAI", display = display.none)
